<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Detection marker for the widget; also a styling hook. -->
        <attribute name="class" value="idea89-mini-pdp"/>

        <!-- Strip the site chrome so only the product view (media, price,
             swatches, add-to-cart) remains. The product-view blocks and their
             JS are left intact, so add-to-cart and configurable options work
             exactly as on the real PDP. -->
        <referenceContainer name="header.container" remove="true"/>
        <referenceContainer name="footer-container" remove="true"/>
        <referenceContainer name="navigation.sections" remove="true"/>
        <referenceBlock name="catalog.topnav" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceContainer name="catalog.compare.sidebar" remove="true"/>
        <referenceContainer name="sidebar.main" remove="true"/>
        <referenceContainer name="sidebar.additional" remove="true"/>
        <referenceBlock name="catalog.product.related" remove="true"/>
        <referenceBlock name="product.info.upsell" remove="true"/>
        <referenceContainer name="page.bottom.container" remove="true"/>
    </body>
</page>
